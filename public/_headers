# Cloudflare Workers Static Assets / Pages Cache Headers
# Ensure service worker, manifest, and SPA shell always revalidate immediately on deploy
# so mobile, tablet, and PC PWAs receive GitHub -> Cloudflare production updates automatically
# without ever touching device-local store data in localStorage/IndexedDB.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-DNS-Prefetch-Control: off
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Cache-Control: public, max-age=31536000, immutable

/icon.svg
  Cache-Control: public, max-age=3600, must-revalidate

/icon-192.png
  Cache-Control: public, max-age=3600, must-revalidate

/icon-512.png
  Cache-Control: public, max-age=3600, must-revalidate

/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
